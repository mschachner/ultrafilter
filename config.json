{
  "site": "https://mschachner.github.io/ultrafilter/",

  "blogroll": {
    "itemsPerFeed": 8,
    "maxAgeDays": 400,
    "rollPath": "blogroll.json",
    "targetSize": 40,
    "trialDays": 42,
    "timezone": "America/New_York",
    "topics": [
      { "id": "math",    "label": "Mathematics", "color": "#4756A8" },
      { "id": "sci",     "label": "Sciences",    "color": "#1F7A70" },
      { "id": "arthist", "label": "Art history", "color": "#A2731F" },
      { "id": "arts",    "label": "Arts",        "color": "#94456F" },
      { "id": "climate", "label": "Climate",     "color": "#557A33" }
    ]
  },

  "weather": {
    "place": "Ithaca",
    "latitude": 42.444,
    "longitude": -76.502,
    "timezone": "America/New_York",
    "temperatureUnit": "celsius",
    "windSpeedUnit": "mph",
    "days": 5
  },

  "wikipedia": {
    "picksPerDay": 3,
    "timezone": "America/New_York",
    "topics": [
      { "id": "math",    "label": "Mathematics", "articleTopics": ["mathematics"] },
      { "id": "sci",     "label": "Sciences",    "articleTopics": ["physics", "chemistry", "biology", "space"] },
      { "id": "arthist", "label": "Art history", "articleTopics": ["visual-arts", "architecture"] },
      { "id": "arts",    "label": "Arts",        "articleTopics": ["performing-arts", "music"] },
      { "id": "climate", "label": "Climate",     "articleTopics": ["earth-and-environment"] }
    ]
  },

  "wikis": {
    "timezone": "America/New_York",
    "tabs": ["wikipedia", "nlab", "sep", "attic", "oeis", "mathoverflow", "arxiv"],
    "nlab":         { "poolSize": 12 },
    "sep":          { "poolSize": 9 },
    "attic":        { "poolSize": 9 },
    "oeis":         { "poolSize": 8, "maxNumber": 395000 },
    "mathoverflow": { "tags": ["set-theory"], "days": 7, "count": 8 },
    "arxiv":        { "categories": ["math.LO"], "count": 10 }
  },

  "artwork": {
    "timezone": "America/New_York",
    "interests": [
      { "id": "modern",       "label": "Modern art",               "movements": ["Q38166"],  "weight": 3, "viaCreator": true },
      { "id": "implandscape", "label": "Impressionist landscapes", "movements": ["Q40415"],  "genres": ["Q191163"], "viaCreator": true },
      { "id": "abex",         "label": "Abstract Expressionism",   "movements": ["Q177725"], "viaCreator": true },
      { "id": "surrealism",   "label": "Surrealism",               "movements": ["Q39427"],  "viaCreator": true },
      { "id": "ukiyoe",       "label": "Ukiyo-e",                  "genres": ["Q185905"],
        "classes": ["Q3305213", "Q11060274", "Q28913685", "Q18219090", "Q19960510"] },
      { "id": "popart",       "label": "Pop Art",                  "movements": ["Q134147"], "viaCreator": true },
      { "id": "contemporary", "label": "Contemporary",             "movements": ["Q186030"], "from": 1960, "viaCreator": true },
      { "id": "sculpture",    "label": "Sculpture",                "classes": ["Q860861"],   "from": 1900 }
    ]
  },

  "store": {
    "repo": "mschachner/ultrafilter",
    "branch": "data",
    "dir": "store"
  },

  "albums": {
    "path": "albums/latest.json",
    "dir": "albums",
    "historyPath": "recommendation_history.csv"
  }
}
